// The binary-trees benchmark of the Computer Language Benchmarks Game: many
// short-lived perfect trees, plus one tree that lives for the whole run.
class Node {
    left: Node?
    right: Node?

    fn check(self) -> i64 {
        1 + (self.left?.check() ?? 0) + (self.right?.check() ?? 0)
    }
}

fn make(depth: i64) -> Node {
    if depth == 0 {
        Node(left: None, right: None)
    } else {
        Node(left: make(depth - 1), right: make(depth - 1))
    }
}

fn main() {
    let min_depth = 4
    let max_depth = 18
    print(make(max_depth + 1).check())
    let long_lived = make(max_depth)
    let mut depth = min_depth
    while depth <= max_depth {
        let mut iterations = 1
        let mut k = 0
        while k < max_depth - depth + min_depth {
            iterations *= 2
            k += 1
        }
        let mut check = 0
        let mut i = 0
        while i < iterations {
            check += make(depth).check()
            i += 1
        }
        print(iterations)
        print(check)
        depth += 2
    }
    print(long_lived.check())
}
