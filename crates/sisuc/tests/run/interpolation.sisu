// Interpolation writes each type it takes as `print` does, evaluates its parts left to right, and
// allocates its result only after every part has finished, so a part that leaves early leaks
// nothing.
fn f() -> string {
    print("f")                       // f
    "a" + ""
}

fn g() -> i64 {
    print("g")                       // g
    1
}

// The first part leaves before anything is evaluated.
fn first(c: bool) {
    print("{ if c { return } else { 1 } }")
}

// Only scalar parts come before the one that leaves.
fn scalars(c: bool) {
    print("{1}{true}{ if c { return } else { 'a' } }")
}

// A part that never finishes: neither does the interpolation, which allocates nothing.
fn leave() -> i64 {
    "{1}{ { return 5 } }"
}

fn main() {
    let s = "ab" + "c"
    let n = -42
    let b: u8 = 255
    print("{s} {n} {b} {true} {false} {'ä'} {'😀'}") // abc -42 255 true false ä 😀
    print("{-9223372036854775808}")  // -9223372036854775808
    let t = "b" + ""
    print("{ "a" + t }!")            // ab!
    print("{f()}{g()}")              // f, then g, then a1
    first(false)                     // 1
    first(true)
    scalars(false)                   // 1truea
    scalars(true)
    print(leave())                   // 5
}
