fn iterations() -> i64 { 1000 }

class P {
    mut name: string
}

// `p.name = p.name + "x"` reads its own place, so it appends in place as `p.name += "x"` does:
// one copy of the literal, then a reallocation at each doubling to 1024.
fn main() {
    let p = P(name: "a")
    for i in 0..iterations() {
        p.name = p.name + "x"
    }
    print(p.name.len())              // 1001 (1 with no iterations)
}
