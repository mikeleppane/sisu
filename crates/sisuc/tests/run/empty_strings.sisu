// The empty string is a real string: it has a length, equals itself and sorts first.
fn main() {
    print("".len())                  // 0
    print("" == "")                  // true
    print("" < "a")                  // true
    print("" + "")                   // (an empty line)
    let mut e = ""
    e += "x"
    print(e)                         // x
}
