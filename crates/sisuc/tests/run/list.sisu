// A list of 100 000 nodes. Its drop at the end of `main` follows `next` in a loop: a
// recursive drop of this many nodes, under Valgrind, nearly fills the default stack.
class Node {
    value: i64
    next: Node?
}

fn main() {
    let mut head: Node? = None
    let mut i = 0
    while i < 100_000 {
        i += 1
        head = Node(value: i, next: head)
    }
    let mut length = 0
    let mut sum = 0
    let mut node = head
    while let n = node {
        length += 1
        sum += n.value
        node = n.next
    }
    print(length)
    print(sum)
}
