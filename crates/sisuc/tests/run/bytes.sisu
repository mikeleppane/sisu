// `u8`: checked unsigned arithmetic, comparisons, conversions and optionals.
fn half(b: u8) -> u8 { b / 2 }
fn maybe(c: bool) -> u8? { if c { 7 } else { None } }
fn main() {
    let a: u8 = 200
    let b: u8 = 55
    print(a + b)              // 255
    print(a > b)              // true
    print(half(a) % 7)        // 2
    print(i64(a) * 2)         // 400
    print(u8(65) - 1)         // 64
    print(maybe(true) == 7)   // true
    print(maybe(false) == None) // true
    let mut c: u8 = 0
    c += 250
    print(c)                  // 250
    print(u8(255))            // 255
}
