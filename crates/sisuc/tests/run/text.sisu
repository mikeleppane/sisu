// `chars()`, `bytes()` and `string(cs)` on text of every UTF-8 width: 1, 2, 3 and 4 bytes.
fn main() {
    let s = "aä€😀"
    let cs = s.chars()
    print(cs.len())                  // 4
    for c in cs {
        print(i64(c))                // 97, then 228, 8364 and 128512
    }
    let bs = s.bytes()
    print(bs.len())                  // 10
    for b in bs {
        print(b)                     // 97, then 195 164, 226 130 172 and 240 159 152 128
    }
    print(s.len())                   // 10: the bytes agree with `len()`
    print(string(cs) == s)           // true: the round trip
    let back = [cs[3], cs[2], cs[1], cs[0]]
    print(string(back))              // 😀€äa
    print(string(cs))                // aä€😀: `cs` is still live after `string(cs)`
    // A zero byte is a text byte like any other.
    let z = "a\0b"
    print(z.chars().len())           // 3
    print(i64(z.bytes()[1]))         // 0
    print(string(z.chars()) == z)    // true
    // Built at run time and used once, so that Valgrind sees them released: an owned receiver of
    // `chars()` and `bytes()`, and an owned argument of `string(...)`.
    let t = "ä" + "€"
    print(t.chars().len())           // 2
    print(("a" + "ä").bytes().len()) // 3
    print(string(("ä" + "€").chars())) // ä€
}
