// A class with no `f64` is `==` to itself, so `==` on one object stops at the same pointer. Without
// that, `a == a` would follow the chain `a.next = a` forever.
class Node {
    value: i64
    mut next: Node?
}

fn main() {
    let a = Node(value: 1, next: None)
    a.next = a
    print(a == a) // true: same pointer, so the cycle is not followed
    a.next = None // breaks the cycle, so the object is freed
}
