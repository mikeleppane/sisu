// A conversion that can fail gives an optional: `None` outside the target type, and no panic.
// Each boundary is converted on both sides, as a literal that folds away and again as a run-time
// value: `same_int` returns its argument at a depth that `-O2` does not know, so the range checks
// run on values LLVM cannot fold. `main(args)` gets `a`, so the depth is 1.
// args: a
// o2-calls: main same_int 10
fn same_int(n: i64, depth: i64) -> i64 {
    if depth == 0 { n } else { -same_int(-n, depth - 1) }
}

fn show_u8(b: u8?) {
    if let v = b {
        print(i64(v)) // the value
    } else {
        print("none") // none
    }
}

fn show_char(c: char?) {
    if let v = c {
        print(v) // the character
    } else {
        print("none") // none
    }
}

fn main(args: [string]) {
    show_u8(u8(0))            // 0
    show_u8(u8(255))          // 255
    show_u8(u8(256))          // none
    show_u8(u8(-1))           // none
    show_char(char(0xD7FF))   // U+D7FF, the last scalar value below the surrogates
    show_char(char(0xD800))   // none: the first surrogate
    show_char(char(0xDFFF))   // none: the last surrogate
    show_char(char(0xE000))   // U+E000, the first scalar value above them
    show_char(char(0x10FFFF)) // U+10FFFF, the last scalar value
    show_char(char(0x110000)) // none
    show_char(char(-1))       // none
    let c = '7'
    let d = u8(i64(c) - 48) ?? panic("not a digit")
    print(i64(d))             // 7
    let n = 300
    print(i64(u8(n) ?? 9))    // 9
    let d = args.len()
    let minus = same_int(-1, d)
    show_u8(u8(minus))                // none
    show_u8(u8(same_int(0, d)))       // 0
    show_u8(u8(same_int(255, d)))     // 255
    show_u8(u8(same_int(256, d)))     // none
    show_char(char(same_int(0xD7FF, d)))   // U+D7FF
    show_char(char(same_int(0xD800, d)))   // none
    show_char(char(same_int(0xDFFF, d)))   // none
    show_char(char(same_int(0xE000, d)))   // U+E000
    show_char(char(same_int(0x10FFFF, d))) // U+10FFFF
    show_char(char(same_int(0x110000, d))) // none
    show_char(char(minus))            // none
}
