fn boom() -> bool {
    print(1 / 0)
    true
}

fn mid() -> i64 {
    print(99)
    3
}

fn fail() -> i64 {
    print(1 / 0)
    0
}

fn sign(n: i64) -> i64 {
    if n < 0 { return -1 } else { return 1 }
}

fn pick(c: bool) -> i64 {
    if c { return 1 } else { 2 }
}

fn main() {
    print(-7 / 2)
    print(-7 % 2)
    print(1 < 2 <= 2)
    print(3 > 2 > 2)
    print(false && boom())
    print(true || boom())
    print(!true)
    print(1 < mid() <= 5)
    let x = if 1 == 1 { 10 } else { 20 }
    print(x)
    print(-x)
    print(sign(-5))
    print(3 < 2 < fail())
    print(2 > 3 > fail())
    print(pick(true))
    print(pick(false))
    print(1 != 2)
    print(2 != 2)
    print(true == false)
    print(true != false)
}
