fn main() {
    let mut i = 0
    let mut total = 0
    while i < 5 {
        let mut sq = i * i
        sq += 1
        total += sq
        i += 1
    }
    print(total)
    let mut x = 17
    x -= 2
    x *= 3
    x /= 4
    x %= 4
    print(x)
    let mut pairs = 0
    let mut a = 0
    while a < 4 {
        let mut b = 0
        while b < a {
            pairs += 1
            b += 1
        }
        a += 1
    }
    print(pairs)
}
