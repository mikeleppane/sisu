// `==` follows the chain field (`next`) pair by pair: the lists below differ only in the last
// node, in their length, or not at all, with the chain field last (`Last`) and first (`First`).
class Last {
    value: i64
    next: Last?
}

class First {
    next: First?
    value: i64
}

fn last(values: [i64]) -> Last? {
    let mut head: Last? = None
    for value in values {
        head = Last(value: value, next: head)
    }
    head
}

fn first(values: [i64]) -> First? {
    let mut head: First? = None
    for value in values {
        head = First(next: head, value: value)
    }
    head
}

fn main() {
    let a = last([3, 2, 1])
    print(a == a) // true: same pointer
    print(a == last([3, 2, 1])) // true: equal field by field
    print(a == last([3, 2, 9])) // false: the last node differs
    print(a == last([9, 2, 1])) // false: the first node differs
    print(a == last([2, 1])) // false: shorter list
    print(last([2, 1]) == a) // false: shorter on the left
    print(a == None) // false: one side is None
    print(last([]) == last([])) // true: two Nones
    print(a != last([3, 2, 9])) // true: `!=` negates the false above

    let b = first([3, 2, 1])
    print(b == b) // true: same pointer
    print(b == first([3, 2, 1])) // true: equal field by field
    print(b == first([3, 2, 9])) // false: the last node differs
    print(b == first([9, 2, 1])) // false: the first node differs
    print(b == first([2, 1])) // false: shorter list
    print(first([2, 1]) == b) // false: shorter on the left
    print(b == None) // false: one side is None
    print(first([]) == first([])) // true: two Nones
}
