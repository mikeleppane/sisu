fn iterations() -> i64 { 1000 }

// `big = fill(big, i, i % 2 + 1)` hands the only reference to `fill`; `let mut ys = xs` and the
// recursive call each move it on, so `ys[0] = v` finds the block unshared and writes in place:
// the loop makes no copy. `fill` recurses, and its depth is 1 or 2, so that neither the inliner
// nor constant propagation across functions can fold the call into `main` at `-O2`.
// o2-calls: main fill 1
fn fill(xs: [i64], v: i64, depth: i64) -> [i64] {
    let mut ys = xs
    if depth > 0 {
        ys = fill(ys, v, depth - 1)
    }
    ys[0] = v
    ys
}

fn main() {
    let mut big = [0; 10_000]
    for i in 0..iterations() {
        big = fill(big, i, i % 2 + 1)
    }
    print(big[0]) // the last i: 999 (0 with no iterations)
}
