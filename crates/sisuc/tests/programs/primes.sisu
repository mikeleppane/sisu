// Counts the primes below 100 000.
fn is_prime(n: i64) -> bool {
    if n < 2 { return false }
    var d = 2
    while d * d <= n {
        if n % d == 0 { return false }
        d += 1
    }
    true
}

fn main() {
    var count = 0
    var n = 2
    while n < 100_000 {
        if is_prime(n) { count += 1 }
        n += 1
    }
    print(count)
}
