fn iterations() -> i64 { 1000 }

fn fill(xs: [i64], v: i64) -> [i64] {
    var ys = xs
    ys[0] = v
    ys
}

// `saved` is live across the write, so each `fill` must copy: one allocation per iteration.
fn main() {
    var big = [0; 10_000]
    var total = 0
    for i in 0..iterations() {
        let saved = big
        big = fill(big, i + 1)
        total += saved[0]
    }
    print(total) // 0 + 1 + ... + 999 = 499500: each `saved[0]` is the previous `i`
    print(big[0]) // the last i + 1: 1000 (0 with no iterations)
}
